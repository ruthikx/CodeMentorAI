{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["fallback.ts", "parser.ts", "prompts.ts", "provider.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "tests"]
}
